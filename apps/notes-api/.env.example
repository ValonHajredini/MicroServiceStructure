# Application Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notes_db
DB_USERNAME=postgres
DB_PASSWORD=password

# Database URL (constructed from above or set directly)
DATABASE_URL=postgresql://postgres:password@localhost:5432/notes_db

# JWT Authentication Configuration (shared across all services)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRATION=24h

# CORS Configuration (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:4200,http://localhost:4201
