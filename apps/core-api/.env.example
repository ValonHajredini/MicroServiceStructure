# Application Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/core_db

# JWT Authentication Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_EXPIRATION=24h

# Password Security Configuration
BCRYPT_ROUNDS=10

# Email Service Configuration
# OPTIONAL: SendGrid for production email delivery
# If not configured, emails will be logged to console with HTML preview files
# Sign up at https://sendgrid.com/ to get an API key
# SENDGRID_API_KEY=your-sendgrid-api-key-starting-with-SG
EMAIL_FROM=noreply@yourdomain.com

# Development Note:
# - Without SENDGRID_API_KEY: Emails logged to console + HTML saved to tmp/email-previews/
# - With SENDGRID_API_KEY: Emails sent via SendGrid
# HTML preview files can be opened in browser to see styled emails

# Frontend Configuration
FRONTEND_URL=http://localhost:4200

# Password Reset Configuration
PASSWORD_RESET_EXPIRATION_HOURS=1

# CORS Configuration
CORS_ORIGIN=http://localhost:4200

# DigitalOcean Spaces Configuration (S3-compatible storage)
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_ACCESS_KEY=your-access-key
DO_SPACES_SECRET_KEY=your-secret-key
DO_SPACES_REGION=nyc3
