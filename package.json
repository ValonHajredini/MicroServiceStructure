{
  "name": "microservice-structure",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant microservices platform with Turborepo monorepo",
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "libs/*",
    "poc/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@nestjs/throttler": "^6.4.0"
  }
}
